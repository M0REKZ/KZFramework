[submodule "lib/SDL3"]
	path = lib/SDL3
	url = https://github.com/libsdl-org/SDL.git
[submodule "lib/SDL3_mixer"]
	path = lib/SDL3_mixer
	url = https://github.com/libsdl-org/SDL_mixer.git
[submodule "lib/LuaJIT"]
	path = lib/LuaJIT
	url = https://github.com/WohlSoft/LuaJIT.git
[submodule "lib/SDL3_gfx"]
	path = lib/SDL3_gfx
	url = https://github.com/sabdul-khabir/SDL3_gfx.git
